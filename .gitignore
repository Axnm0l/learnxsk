# This .gitignore is configured for Unity C# projects and LearnXSK local AI development.

# =========================================================================
# Unity-generated folders & files
# =========================================================================
/[Gg]ame/[Ll]ibrary/
/[Gg]ame/[Tt]emp/
/[Gg]ame/[Oo]bj/
/[Gg]ame/[Bb]uild/
/[Gg]ame/[Bb]uilds/
/[Gg]ame/[Ll]ogs/
/[Gg]ame/[Uu]ser[Ss]ettings/
/[Gg]ame/[Mm]emoryCaptures/
/[Gg]ame/[Rr]ecordings/

# Asset store packages
/[Gg]ame/Assets/AssetStoreTools*

# Autogenerated VS / Rider / IDE project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
bin/
obj/
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity profiler & crash logs & run logs
sysinfo.txt
*.stackdump
*.log
freebuff_audit_output.txt

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
Desktop.ini

# =========================================================================
# Local AI & Model Weights (MANDATORY: Never commit model weights)
# =========================================================================
*.bin
*.gguf
*.safetensors
*.pt
*.pth
*.onnx
models/
weights/
.ollama/
ollama-cache/
/tools/gemma-smoke-test/*.log
/tools/gemma-smoke-test/*.tmp

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
env/
venv/

# =========================================================================
# ML pipeline artifacts
# -------------------------------------------------------------------------
# These are generated OUTSIDE the repository, under
# C:\Users\anmol\OneDrive\Desktop\hackathon\training. The patterns below only
# catch stray copies so generated data can never be committed by accident.
# =========================================================================
/ml/**/outputs/
/ml/**/runs/
/ml/**/adapters/
/ml/**/exports/
/ml/**/*.jsonl.tmp
/training/
*.jsonl.tmp

# =========================================================================
# Datasets (large files — kept locally, not pushed to GitHub)
# =========================================================================
/ml/datasets/**/*.jsonl
/ml/datasets/**/*.json
/ml/datasets/**/*.tsv
/ml/datasets/**/*.xlsx
/ml/datasets/**/*.pdf
/ml/datasets/**/*.csv

# Web build & dependencies
node_modules/
dist/
.vite/
*.local

# =========================================================================
# SECURE USER DATA VAULT & PRIVATE TELEMETRY (STRICT ISOLATION)
# User questions, telemetry, learning profiles and fine-tuning datasets
# =========================================================================
/backend/secure_user_vault/
secure_user_vault/
*.vault
*.vault.enc
/backend/.env
/backend/build_bundle/
build_bundle/
*.blob
sea-prep.blob
*.exe
LearnXSK.exe

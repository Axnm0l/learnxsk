# =========================================================================
/[Gg]ame/[Ll]ibrary/
/[Gg]ame/[Tt]emp/
/[Gg]ame/[Oo]bj/
/[Gg]ame/[Bb]uild/
/[Gg]ame/[Bb]uilds/
/[Gg]ame/[Ll]ogs/
/[Gg]ame/[Uu]ser[Ss]ettings/
/[Gg]ame/[Mm]emoryCaptures/
/[Gg]ame/[Rr]ecordings/

# Asset store packages
/[Gg]ame/Assets/AssetStoreTools*

# Autogenerated VS / Rider / IDE project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
bin/
obj/
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity profiler & crash logs & run logs
sysinfo.txt
*.stackdump
*.log
freebuff_audit_output.txt

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
Desktop.ini

